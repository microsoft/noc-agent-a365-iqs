# =============================================================================
# Microsoft Foundry — the project the MAF agent (agent/agent.py) connects to
# =============================================================================
# Populated automatically by azd after `azd up` (see infra/main.bicep outputs).
FOUNDRY_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4
AZURE_TENANT_ID=

# =============================================================================
# Foundry project connections (Azure AI Foundry project -> Connections blade).
# All 4 IQ tools are native Foundry-hosted MCP tools referenced by connection
# name; the app resolves each to a connection ID once at startup
# (agent/agent.py NocAgent.initialize). Override only if your connection
# names differ from these defaults.
# =============================================================================
# FOUNDRY_IQ_CONNECTION_NAME=kb-mcp-connection
# Gate A proof only. Set BOTH after provisioning the dedicated Toolbox/APIM
# route/proxy connection; leaving either unset keeps noc-knowledge-agent direct.
# FOUNDRY_IQ_TOOLBOX_NAME=noc-foundry-iq-gate-a
# FOUNDRY_IQ_PROXY_CONNECTION_NAME=foundry-iq-apim-proxy
# FOUNDRY_IQ_PROXY_MCP_URL=https://<apim>.azure-api.net/specialists/foundry-iq/mcp
# Provisioning script only; retrieve from the gateway's Key Vault output.
# FOUNDRY_IQ_PROXY_APIM_SUBSCRIPTION_KEY=
# WEB_IQ_CONNECTION_NAME=web-iq-connection
# FABRIC_IQ_CONNECTION_NAME=fabric-iq-connection
# WORK_IQ_CONNECTION_NAME=WorkIQ

# =============================================================================
# Foundry IQ — knowledge base MCP (scripts/create_foundry_iq_kb.py) —
# used only by the KB-creation script itself, not by the running agent.
# =============================================================================
AZURE_AI_SEARCH_SERVICE_ENDPOINT=
AZURE_AI_SEARCH_KNOWLEDGE_BASE_NAME=noc-knowledge-kb

# =============================================================================
# Fabric IQ — Fabric Data Agent MCP (scripts/create_fabric_ontology.py +
# scripts/create_fabric_data_agent.py) — used only by the provisioning
# scripts; the running agent only needs FABRIC_IQ_CONNECTION_NAME above.
# =============================================================================
FABRIC_DATA_AGENT_MCP_URL=
FABRIC_TENANT_ID=
FABRIC_WORKSPACE_ID=
FABRIC_CAPACITY_ID=
FABRIC_ONTOLOGY_ID=
FABRIC_ONTOLOGY_NAME=NOCNetworkOntology
FABRIC_DATA_AGENT_NAME=NOCNetworkDataAgent
FABRIC_KQL_QUERY_URI=
FABRIC_KQL_DATABASE_NAME=

# =============================================================================
# Detected-incident monitor (App Service only)
# Disabled until an operator has used /monitor subscribe in the intended
# Teams conversation and pre-consented Fabric IQ, Work IQ, and RTI IQ.
# =============================================================================
INCIDENT_MONITOR_ENABLED=false
AZURE_STORAGE_ACCOUNT_NAME=
AGENT_STATE_CONTAINER_NAME=agent-state
INCIDENT_MONITOR_POLL_SECONDS=30
INCIDENT_MONITOR_FIRST_LOOKBACK_MINUTES=15
INCIDENT_MONITOR_MAX_CATCHUP_MINUTES=120
INCIDENT_MONITOR_OVERLAP_SECONDS=30
INCIDENT_MONITOR_BATCH_SIZE=20
INCIDENT_MONITOR_MAX_ATTEMPTS=3
INCIDENT_MONITOR_LEASE_SECONDS=60
INCIDENT_MONITOR_SPECIALIST_CONCURRENCY=3

# OBO token scope used to build the whole per-turn FoundryChatClient/Agent as
# the calling Teams user. Foundry's own service performs its own server-side
# OBO exchange from this identity to each UserEntraToken tool connection's
# real audience (Fabric IQ, Work IQ) -- do NOT use cognitiveservices.azure.com.
# FOUNDRY_USER_TOKEN_SCOPES=https://ai.azure.com/.default

# =============================================================================
# A365 Authentication (populated by `a365 setup all`)
# =============================================================================
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__SCOPES=

AUTH_HANDLER_NAME=AGENTIC
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__AGENTIC__SETTINGS__TYPE=AgenticUserAuthorization
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__AGENTIC__SETTINGS__SCOPES=https://ai.azure.com/.default
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__AGENTIC__SETTINGS__ALT_BLUEPRINT_NAME=SERVICE_CONNECTION
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__AGENTIC__SETTINGS__ALTERNATEBLUEPRINTCONNECTIONNAME=https://ai.azure.com/.default

CONNECTIONSMAP_0_SERVICEURL=*
CONNECTIONSMAP_0_CONNECTION=SERVICE_CONNECTION

USE_AGENTIC_AUTH=true

# =============================================================================
# Observability (populated by a365 CLI)
# =============================================================================
ENABLE_OBSERVABILITY=true
ENABLE_A365_OBSERVABILITY_EXPORTER=false
PYTHON_ENVIRONMENT=development
LOG_LEVEL=INFO
APPLICATIONINSIGHTS_CONNECTION_STRING=

# AGENT_ID=<populated by a365 CLI>
# AGENT365OBSERVABILITY__AGENTID=<populated by a365 CLI>
# AGENT365OBSERVABILITY__AGENTBLUEPRINTID=<populated by a365 CLI>
# AGENT365OBSERVABILITY__CLIENTID=<populated by a365 CLI>
# AGENT365OBSERVABILITY__CLIENTSECRET=<populated by a365 CLI>
# AGENT365OBSERVABILITY__TENANTID=<populated by a365 CLI>
# AGENT365OBSERVABILITY__AGENTNAME=<populated by a365 CLI>
# AGENT365OBSERVABILITY__AGENTDESCRIPTION=<populated by a365 CLI>

# =============================================================================
# Outbound multi-persona notifications (agent/notifications.py, optional).
# See docs/OUTBOUND_NOTIFICATIONS.md. Requires the Mail.Send consent grant in
# docs/DEPLOYMENT.md step 6b. Each persona is skipped (not an error) if its
# recipients env var is unset -- safe to leave all four blank in this PoC.
# =============================================================================
# GRAPH_MAIL_TOKEN_SCOPES=https://graph.microsoft.com/.default
# NOTIFY_EXECUTIVES_EMAILS=
# NOTIFY_TECHNICAL_EMAILS=
# NOTIFY_VENUE_EMAILS=
# NOTIFY_PARTNER_EMAILS=

# =============================================================================
# Server
# =============================================================================
PORT=3978
