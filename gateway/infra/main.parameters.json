{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "owner": {
      "value": "${owner}"
    },
    "costCenter": {
      "value": "${costCenter}"
    },
    "apimPublisherName": {
      "value": "${apimPublisherName}"
    },
    "apimPublisherEmail": {
      "value": "${apimPublisherEmail}"
    },
    "apimSkuName": {
      "value": "${apimSkuName=StandardV2}"
    },
    "budgetAlertEmail": {
      "value": "${budgetAlertEmail}"
    },
    "budgetStartDate": {
      "value": "${budgetStartDate=2026-08-01T00:00:00Z}"
    },
    "workerImage": {
      "value": "${workerImage}"
    },
    "adminUiImage": {
      "value": "${adminUiImage}"
    },
    "mcpHostImage": {
      "value": "${mcpHostImage}"
    },
    "mcpFoundryProjectEndpoint": {
      "value": "${mcpFoundryProjectEndpoint}"
    },
    "mcpFoundryModelDeploymentName": {
      "value": "${mcpFoundryModelDeploymentName}"
    },
    "mcpFabricWorkspaceId": {
      "value": "${FABRIC_WORKSPACE_ID}"
    },
    "mcpFabricGraphModelId": {
      "value": "${FABRIC_GRAPH_MODEL_ID}"
    },
    "mcpFoundryProjectResourceId": {
      "value": "${mcpFoundryProjectResourceId}"
    },
    "mcpSearchServiceResourceId": {
      "value": "${mcpSearchServiceResourceId}"
    },
    "mcpCallerPrincipalId": {
      "value": "${mcpCallerPrincipalId}"
    },
    "mcpCallerPrincipalType": {
      "value": "${mcpCallerPrincipalType=Group}"
    },
    "mcpServerAppClientId": {
      "value": "${mcpServerAppClientId}"
    },
    "mcpServerAudience": {
      "value": "${mcpServerAudience}"
    },
    "entraTenantId": {
      "value": "${entraTenantId}"
    },
    "entraApiAudience": {
      "value": "${entraApiAudience}"
    },
    "bffApiAudience": {
      "value": "${bffApiAudience}"
    },
    "spaClientId": {
      "value": "${spaClientId}"
    },
    "adminGroupObjectId": {
      "value": "${adminGroupObjectId}"
    },
    "deleteByDate": {
      "value": "${deleteByDate}"
    }
  }
}
