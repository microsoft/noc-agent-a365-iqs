{
  "_comment": "Template only — copy to a365.config.json (gitignored) and fill in tenant-specific values before running `a365 setup all`. Never commit the real a365.config.json.",
  "tenantId": "<your-tenant-id>",
  "subscriptionId": "<your-subscription-id>",
  "resourceGroup": "<resource-group>",
  "location": "<azure-region>",
  "environment": "dev",
  "needDeployment": false,
  "graphBaseUrl": "https://graph.microsoft.com",
  "clientAppId": "<populated after app registration>",
  "appServicePlanName": "ASP-noc-agent-a365",
  "appServicePlanSku": "B1",
  "webAppName": "<from infra/main.bicep output agentHostAppName>",
  "agentIdentityDisplayName": "noc-agent Identity",
  "agentBlueprintDisplayName": "noc-agent Blueprint",
