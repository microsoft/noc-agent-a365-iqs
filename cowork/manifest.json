{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.28/MicrosoftTeams.schema.json",
  "manifestVersion": "1.28",
  "version": "1.0.0",
  "id": "${MANIFEST_ID}",
  "developer": {
    "name": "Microsoft",
    "websiteUrl": "https://github.com/microsoft/noc-agent-a365-iqs",
    "privacyUrl": "https://privacy.microsoft.com/privacystatement",
    "termsOfUseUrl": "https://www.microsoft.com/servicesagreement"
  },
  "name": {
    "short": "NOC Investigation",
    "full": "NOC Investigation for Copilot Cowork"
  },
  "description": {
    "short": "Read-only NOC incident investigation with specialist grounding",
    "full": "Investigate network incidents, blast radius, telemetry evidence, runbooks, public advisories, and stakeholder context through the existing NOC orchestrator."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#0F6CBD",
  "agentConnectors": [
    {
      "id": "noc-investigation-mcp",
      "displayName": "NOC Investigation MCP",
      "description": "Read-only incident investigation through the existing NOC orchestrator and its five specialists.",
      "toolSource": {
        "remoteMcpServer": {
          "mcpServerUrl": "${MCP_URL}",
          "mcpToolDescription": {
            "file": "./tools/noc-mcp-tools.json"
          },
          "authorization": {
            "type": "OAuthPluginVault",
            "referenceId": "${AUTH_CONFIG_REFERENCE_ID}"
          }
        }
      }
    }
  ],
  "agentSkills": [
    {
      "folder": "./skills/incident-triage"
    },
    {
      "folder": "./skills/blast-radius"
    },
    {
      "folder": "./skills/customer-comms"
    }
  ]
}
