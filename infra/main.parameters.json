{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "principalType": {
      "value": "User"
    },
    "webIqMcpEndpoint": {
      "value": "${webIqMcpEndpoint=https://api.microsoft.ai/v3/mcp}"
    },
    "searchServiceSku": {
      "value": "${searchServiceSku=basic}"
    },
    "searchServiceLocation": {
      "value": "${searchServiceLocation}"
    },
    "agentHostLocation": {
      "value": "${agentHostLocation}"
    },
    "enablePrivateStorageAccess": {
      "value": "${enablePrivateStorageAccess=true}"
    },
    "networkIsolation": {
      "value": "${NETWORK_ISOLATION=false}"
    },
    "enableFoundryIqGateway": {
      "value": "${enableFoundryIqGateway=false}"
    },
    "foundryIqToolboxBackendUrl": {
      "value": "${foundryIqToolboxBackendUrl=}"
    },
    "apimPublisherName": {
      "value": "${apimPublisherName=NOC IQ Demo}"
    },
    "apimPublisherEmail": {
      "value": "${apimPublisherEmail=admin@contoso.com}"
    },
    "fabricCapacityLocation": {
      "value": "${fabricCapacityLocation}"
    },
    "webIqApiKey": {
      "value": "${webIqApiKey}"
    },
    "deleteByDate": {
      "value": "${deleteByDate}"
    },
    "fabricAdminUpn": {
      "value": "${fabricAdminUpn}"
    },
    "fabricWorkspaceId": {
      "value": "${FABRIC_WORKSPACE_ID}"
    },
    "fabricGraphModelId": {
      "value": "${FABRIC_GRAPH_MODEL_ID}"
    },
    "fabricKqlQueryUri": {
      "value": "${FABRIC_KQL_QUERY_URI}"
    },
    "fabricKqlDatabaseName": {
      "value": "${FABRIC_KQL_DATABASE_NAME}"
    },
    "incidentMonitorEnabled": {
      "value": "${incidentMonitorEnabled=false}"
    },
    "directKqlToolEnabled": {
      "value": "${directKqlToolEnabled=false}"
    },
    "directSqlToolEnabled": {
      "value": "${directSqlToolEnabled=false}"
    },
    "fabricSqlEndpoint": {
      "value": "${FABRIC_SQL_ENDPOINT}"
    },
    "fabricSqlDatabase": {
      "value": "${FABRIC_SQL_DATABASE}"
    },
    "fabricApiBaseUrl": {
      "value": "${FABRIC_API_BASE_URL=https://api.fabric.microsoft.com}"
    }
  }
}
