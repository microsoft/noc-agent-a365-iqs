{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "principalType": {
      "value": "User"
    },
    "webIqMcpEndpoint": {
      "value": "${webIqMcpEndpoint=https://api.microsoft.ai/v3/mcp}"
    },
    "searchServiceSku": {
      "value": "${searchServiceSku=basic}"
    },
    "searchServiceLocation": {
      "value": "${searchServiceLocation}"
    },
    "agentHostLocation": {
      "value": "${agentHostLocation}"
    },
    "fabricCapacityLocation": {
      "value": "${fabricCapacityLocation}"
    },
    "webIqApiKey": {
      "value": "${webIqApiKey}"
    },
    "deleteByDate": {
      "value": "${deleteByDate}"
    },
    "fabricAdminUpn": {
      "value": "${fabricAdminUpn}"
    },
    "fabricWorkspaceId": {
      "value": "${FABRIC_WORKSPACE_ID}"
    },
    "fabricGraphModelId": {
      "value": "${FABRIC_GRAPH_MODEL_ID}"
    }
  }
}
